<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<Button android:id="@+id/audio_guide_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/audio_guide_back" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_guide_heading" android:textSize="26sp" android:textStyle="bold" android:accessibilityHeading="true" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_guide_intro" android:paddingBottom="16dp" />
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ListView android:id="@+id/audio_guide_list" android:layout_width="match_parent" android:layout_height="match_parent" android:dividerHeight="12dp" />
<ScrollView android:id="@+id/audio_guide_detail" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

<TextView android:id="@+id/audio_guide_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:paddingTop="12dp" />
<TextView android:id="@+id/audio_guide_detail_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:lineSpacingExtra="6dp" android:paddingTop="12dp" android:textIsSelectable="true" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<Button android:id="@+id/audio_guide_play" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_guide_play" />
<Button android:id="@+id/audio_guide_pause" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_guide_pause" />
<Button android:id="@+id/audio_guide_stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/audio_guide_stop" />
<TextView android:id="@+id/audio_guide_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:text="@string/audio_guide_ready" />
</LinearLayout>
</LinearLayout></ScrollView></FrameLayout></LinearLayout>
